{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Lato|Playfair Display|Poppins|Montez))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Lato, Playfair Display, Poppins, Montez."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow1'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Arrow1> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Calendar'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|icon2|icon3|icon4|key|ref|className|style|children)$/]",
        "message": "<Calendar> doesn't accept that prop. Declared props: className, style, text1, icon2, icon3, icon4."
      },
      {
        "selector": "JSXOpeningElement[name.name='Color'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|swatch|text1|text2|key|ref|className|style|children)$/]",
        "message": "<Color> doesn't accept that prop. Declared props: className, style, swatch, text1, text2."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateActive'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|icon1|key|ref|className|style|children)$/]",
        "message": "<DateActive> doesn't accept that prop. Declared props: className, style, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateInactive'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|key|ref|className|style|children)$/]",
        "message": "<DateInactive> doesn't accept that prop. Declared props: className, style, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='FluentArrowUp16Filled'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<FluentArrowUp16Filled> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glowing'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|arrow|type|text|hover|icon1|key|ref|className|style|children)$/]",
        "message": "<Glowing> doesn't accept that prop. Declared props: className, style, arrow, type, text, hover, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glowing'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Glowing> type must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icons'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|icon|key|ref|className|style|children)$/]",
        "message": "<Icons> doesn't accept that prop. Declared props: className, style, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icons'] > JSXAttribute[name.name='icon'] > Literal[value!=/^(?:check-bold|dots-vertical|close|arrow-down|arrow-up|arrow-left|arrow-right|download)$/]",
        "message": "<Icons> icon must be one of 'check-bold' | 'dots-vertical' | 'close' | 'arrow-down' | 'arrow-up' | 'arrow-left' | 'arrow-right' | 'download'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Informative'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|hover|buttonText|arrow|tagText|icon1|key|ref|className|style|children)$/]",
        "message": "<Informative> doesn't accept that prop. Declared props: className, style, hover, buttonText, arrow, tagText, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='Month'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|key|ref|className|style|children)$/]",
        "message": "<Month> doesn't accept that prop. Declared props: className, style, text1."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialIcons'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|platform|color|key|ref|className|style|children)$/]",
        "message": "<SocialIcons> doesn't accept that prop. Declared props: className, style, platform, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialIcons'] > JSXAttribute[name.name='platform'] > Literal[value!=/^(?:apple|discord|dribbble|facebook|figma|github|google|instagram|linkedin|medium|pinterest|reddit|signal|snapchat|spotify|telegram|tiktok|tumblr|twitch|vk|youtube|x \\(twitter\\)|threads|whatsapp|messenger|bluesky)$/]",
        "message": "<SocialIcons> platform must be one of 'apple' | 'discord' | 'dribbble' | 'facebook' | 'figma' | 'github' | 'google' | 'instagram' | 'linkedin' | 'medium' | 'pinterest' | 'reddit' | 'signal' | 'snapchat' | 'spotify' | 'telegram' | 'tiktok' | 'tumblr' | 'twitch' | 'vk' | 'youtube' | 'x (twitter)' | 'threads' | 'whatsapp' | 'messenger' | 'bluesky'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialIcons'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:negative|original)$/]",
        "message": "<SocialIcons> color must be one of 'negative' | 'original'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreamlineFilmSlateSolid'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<StreamlineFilmSlateSolid> doesn't accept that prop. Declared props: className, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
